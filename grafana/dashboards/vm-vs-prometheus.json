{
  "title": "VictoriaMetrics vs Prometheus",
  "uid": "vm-vs-prom",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Memory (RSS)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=~\"prometheus|victoriametrics\"}", "legendFormat": "{{job}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU (cores used)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=~\"prometheus|victoriametrics\"}[2m])", "legendFormat": "{{job}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk used by stored data",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "refId": "A", "expr": "sum(vm_data_size_bytes{job=\"victoriametrics\"})", "legendFormat": "victoriametrics" },
        { "refId": "B", "expr": "prometheus_tsdb_storage_blocks_bytes + prometheus_tsdb_wal_storage_size_bytes", "legendFormat": "prometheus" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node CPU usage (same query, both backends)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" }, "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))", "legendFormat": "via VictoriaMetrics" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))", "legendFormat": "via Prometheus" }
      ],
      "datasource": { "type": "datasource", "uid": "-- Mixed --" }
    }
  ]
}
